# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

pdr.xlsx
google-apps-scripts.gs

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# artefactos temporales / del montaje (no commitear)
/.tmptest
.cfgtmp
*.cfgtmp
*.tsx.tmp
.fuse_hidden*
**/.fuse_hidden*

# Evidencia de revisión de diseño (capturas)
.impeccable/review/
.impeccable/mocks/
.playwright-mcp/
.impeccable/hook.cache.json

# Fotos originales de los MCs (solo se suben las reducidas en public/mcs)
/fotos-mcs/*
!/fotos-mcs/LEEME.txt
